# Backend env — consumed by nhost functions and by scripts/.
# Locally: copy to .env and fill in. In nhost Cloud: set these in the project's
# Settings -> Environment Variables (secrets go under Secrets, not plain vars).

# --- Injected automatically by nhost at runtime; only set these for local scripts ---
NHOST_GRAPHQL_URL=https://<subdomain>.graphql.<region>.nhost.run/v1
NHOST_AUTH_URL=https://<subdomain>.auth.<region>.nhost.run/v1
NHOST_ADMIN_SECRET=

# --- Shared secret Hasura sends on Event/Cron trigger calls. Handlers fail closed
#     when it is unset, so a missing value is a refusal, not a bypass. ---
NHOST_WEBHOOK_SECRET=

# --- LLM for the llm_call step. Groq free tier is OpenAI-compatible.
#     Leave LLM_API_KEY empty to fall back to the disclosed stub. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Seed script: password for the four demo users. Min length 9 (nhost auth config). ---
SEED_USER_PASSWORD=
