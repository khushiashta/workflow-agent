{
  "name": "ai-agent-workflow-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "nhost:up": "nhost up",
    "nhost:down": "nhost down",
    "verify:isolation": "node --env-file-if-exists=.env scripts/verify-isolation.ts",
    "verify:gating": "node --env-file-if-exists=.env scripts/verify-step-gating.ts",
    "verify:engine": "node --env-file-if-exists=.env scripts/verify-engine.ts"
  },
  "dependencies": {
    "@nhost/nhost-js": "^4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
