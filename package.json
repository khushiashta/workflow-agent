{
  "name": "ai-agent-workflow-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/seed.ts",
    "demo:prepare": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/prepare-demo.ts",
    "webhook": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/call-webhook.ts",
    "verify:isolation": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-isolation.ts",
    "verify:gating": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-gating.ts",
    "verify:engine": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-engine.ts",
    "verify:approval": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-approval.ts",
    "verify:builder": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-builder.ts",
    "verify:webhook": "node --env-file-if-exists=${ENV_FILE:-.env} scripts/verify-webhook.ts",
    "verify:all": "npm run verify:isolation && npm run verify:gating && npm run verify:engine && npm run verify:approval && npm run verify:builder && npm run verify:webhook",
    "typecheck": "tsc --noEmit",
    "nhost:up": "nhost up",
    "nhost:down": "nhost down"
  },
  "dependencies": {
    "@nhost/nhost-js": "^4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
