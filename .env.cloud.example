# Points the seed and verification suites at the deployed backend instead of local.
# Copy to .env.cloud (gitignored), fill in the two secrets, then:
#
#   ENV_FILE=.env.cloud npm run seed
#   ENV_FILE=.env.cloud npm run verify:all
#
# Running the suites against cloud is the point of the exercise: metadata that applies
# locally can still fail in the cloud, and passing locally is not evidence about what a
# reviewer will open.

NHOST_GRAPHQL_URL=https://urhmwxltlkegrdfqlzpa.graphql.ap-south-1.nhost.run/v1
NHOST_AUTH_URL=https://urhmwxltlkegrdfqlzpa.auth.ap-south-1.nhost.run/v1

# From the nhost dashboard: Settings -> Environment Variables (admin secret is listed
# under the project's connection details).
NHOST_ADMIN_SECRET=

# Only used by the suites for their own assertions; the deployed handlers read the value
# you set as a project secret in the dashboard.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Must match whatever the cloud demo users were seeded with.
SEED_USER_PASSWORD=
